#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    behaviors {
        lumi_rgb: lumi_rgb {
            compatible = "zmk,behavior-lumi-rgb";
            #binding-cells = <1>;
            display-name = "Lumi RGB";
        };

        lumi_action: lumi_action {
            compatible = "zmk,behavior-lumi-action";
            #binding-cells = <1>;
            display-name = "Lumi Action";
        };

        /* Hard recovery for stale/corrupt host bonds:
         * clear every keyboard-side BLE bond, select host slot 0, then prefer BLE.
         */
        ble_recovery: ble_recovery {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&bt BT_CLR_ALL>,
                       <&bt BT_SEL 0>,
                       <&out OUT_BLE>;
        };
    };

    // Hold physical key 1 + key 12 together to unlock ZMK Studio.
    combos {
        compatible = "zmk,combos";

        studio_unlock_combo {
            timeout-ms = <80>;
            key-positions = <0 11>;
            bindings = <&studio_unlock>;
        };

        /* Hold K2 + K3 + K10 + K11 together to recover Bluetooth from any
         * profile, including when the PC-side pairing list has already been wiped.
         */
        ble_recovery_combo {
            timeout-ms = <150>;
            key-positions = <1 2 9 10>;
            bindings = <&ble_recovery>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        office { // Profile 1
            display-name = "OFFICE";
            bindings = <
                &kp LC(C)      &kp LC(V)      &kp LC(X)      &kp LC(Z)
                &kp LC(Y)      &kp LC(A)      &kp LC(S)      &kp LC(F)
                &kp ENTER      &kp BACKSPACE  &kp TAB        &kp ESC
                &to 1
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        media { // Profile 2
            display-name = "MEDIA";
            bindings = <
                &kp C_PLAY_PAUSE   &kp C_PREVIOUS      &kp C_NEXT         &kp C_MUTE
                &kp C_REWIND       &kp C_FAST_FORWARD  &kp C_STOP         &kp F11
                &kp C_AC_BACK      &kp C_AC_FORWARD    &kp HOME           &kp END
                &to 2
            >;
            // Encoder handles volume, so no volume buttons are wasted on the 12-key grid.
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        bambu { // Profile 3
            display-name = "BAMBU STUDIO";
            bindings = <
                &kp LC(R)       &kp LC(LS(G))  &kp LC(G)      &kp LC(I)
                &kp M           &kp R           &kp S          &kp F
                &kp C           &kp A           &kp LS(R)      &kp LC(S)
                &to 3
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        fusion360 { // Profile 4
            display-name = "FUSION 360";
            bindings = <
                &kp E  &kp Q  &kp F  &kp H
                &kp M  &kp I  &kp P  &kp D
                &kp L  &kp R  &kp C  &kp J
                &to 4
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        capcut { // Profile 5
            display-name = "CAPCUT";
            bindings = <
                &kp LC(B)      &kp Q          &kp W          &kp DELETE
                &kp LC(Z)      &kp LC(LS(Z))  &kp LC(D)      &kp SPACE
                &kp LEFT       &kp RIGHT      &kp LC(E)      &kp LC(S)
                &to 5
            >;
            // Encoder scrubs one frame at a time.
            sensor-bindings = <&inc_dec_kp RIGHT LEFT>;
        };

        delta_force { // Profile 6
            display-name = "DELTA FORCE";
            bindings = <
                &kp Y       &kp X       &kp V       &kp G
                &kp N       &kp J       &kp K       &kp EQUAL
                &kp M       &kp LC(M)   &kp U       &kp H
                &to 6
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        wuwa { // Profile 7
            display-name = "WUWA";
            bindings = <
                &kp M   &kp J   &kp B   &kp C
                &kp L   &kp O   &kp F1  &kp F2
                &kp F3  &kp F4  &kp U   &kp T
                &to 7
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        pcmonitor { // Profile 8 - telemetry page
            display-name = "PC MONITOR";
            bindings = <
                &none &none &none &none
                &none &none &none &none
                &none &none &none &none
                &to 8
            >;
            sensor-bindings = <&inc_dec_kp PG_UP PG_DN>;
        };

        reserved9 { // Profile 9 - reserved
            display-name = "RESERVED";
            bindings = <
                &none &none &none &none
                &none &none &none &none
                &none &none &none &none
                &to 9
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        connection { // Profile 10 - wireless/USB connection controls
            display-name = "CONNECTION";
            bindings = <
                &out OUT_BLE  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2
                &out OUT_USB  &bt BT_CLR     &ble_recovery  &bt BT_NXT
                &bt BT_PRV    &none          &none          &none
                &to 0
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
