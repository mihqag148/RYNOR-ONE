#include <zephyr/dt-bindings/gpio/gpio.h>
#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include "lumi_macropad-layouts.dtsi"

/ {
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        // RYNOR ONE handwired 3x5 matrix:
        // ROW0 P0.09, ROW1 P0.10, ROW2 P1.11
        row-gpios
            = <&gpio0 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        // COL0 P1.13, COL1 P1.15, COL2 P0.02, COL3 P0.29, COL4 P0.31
        col-gpios
            = <&gpio1 13 GPIO_ACTIVE_HIGH>
            , <&gpio1 15 GPIO_ACTIVE_HIGH>
            , <&gpio0 2  GPIO_ACTIVE_HIGH>
            , <&gpio0 29 GPIO_ACTIVE_HIGH>
            , <&gpio0 31 GPIO_ACTIVE_HIGH>
            ;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        rows = <3>;
        columns = <5>;

        // Physical layout:
        // ROW0: K1 K2 K3 K4 EC11
        // ROW1: K5 K6 K7 K8
        // ROW2: K9 K10 K11 K12
        //
        // Keep key positions 0..11 as K1..K12 so existing keymaps,
        // combos, Studio mappings and LumiPad behavior stay unchanged.
        // Position 12 remains the EC11 push button.
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3)
            RC(0,4)
        >;
    };

    encoder0: encoder0 {
        compatible = "alps,ec11";
        /* Physical EC11 A/B are wired opposite to the original mapping.
         * Swap the firmware phases so clockwise/counter-clockwise actions
         * match the expected direction without rewiring the encoder.
         */
        a-gpios = <&gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&gpio1 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    /* Dedicated System OFF wake inputs.
     *
     * Do not resume the complete matrix kscan while entering soft-off. Using
     * direct row level-sense inputs avoids scan/debounce latency and makes one
     * key press wake the nRF52840 immediately. For this col2row matrix all five
     * columns are driven HIGH while sleeping, and any row going HIGH wakes.
     *
     * EC11 A/B are passive contacts to GND, so both phases use direct
     * active-low level sensing. A single encoder transition can therefore wake
     * without waiting for the normal EC11 driver to start.
     */
    deep_wake_keys: deep_wake_keys {
        compatible = "gpio-keys";

        deep_wake_row0_key: deep_wake_row0_key {
            gpios = <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        };

        deep_wake_row1_key: deep_wake_row1_key {
            gpios = <&gpio0 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        };

        deep_wake_row2_key: deep_wake_row2_key {
            gpios = <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
        };

        encoder_wake_a_key: encoder_wake_a_key {
            gpios = <&gpio1 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };

        encoder_wake_b_key: encoder_wake_b_key {
            gpios = <&gpio1 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
    };

    deep_wake_row0: deep_wake_row0 {
        compatible = "zmk,gpio-key-wakeup-trigger";
        trigger = <&deep_wake_row0_key>;
        wakeup-source;
        extra-gpios =
            <&gpio1 13 GPIO_ACTIVE_HIGH>,
            <&gpio1 15 GPIO_ACTIVE_HIGH>,
            <&gpio0 2 GPIO_ACTIVE_HIGH>,
            <&gpio0 29 GPIO_ACTIVE_HIGH>,
            <&gpio0 31 GPIO_ACTIVE_HIGH>;
    };

    deep_wake_row1: deep_wake_row1 {
        compatible = "zmk,gpio-key-wakeup-trigger";
        trigger = <&deep_wake_row1_key>;
        wakeup-source;
        extra-gpios =
            <&gpio1 13 GPIO_ACTIVE_HIGH>,
            <&gpio1 15 GPIO_ACTIVE_HIGH>,
            <&gpio0 2 GPIO_ACTIVE_HIGH>,
            <&gpio0 29 GPIO_ACTIVE_HIGH>,
            <&gpio0 31 GPIO_ACTIVE_HIGH>;
    };

    deep_wake_row2: deep_wake_row2 {
        compatible = "zmk,gpio-key-wakeup-trigger";
        trigger = <&deep_wake_row2_key>;
        wakeup-source;
        extra-gpios =
            <&gpio1 13 GPIO_ACTIVE_HIGH>,
            <&gpio1 15 GPIO_ACTIVE_HIGH>,
            <&gpio0 2 GPIO_ACTIVE_HIGH>,
            <&gpio0 29 GPIO_ACTIVE_HIGH>,
            <&gpio0 31 GPIO_ACTIVE_HIGH>;
    };

    encoder_wake_a: encoder_wake_a {
        compatible = "zmk,gpio-key-wakeup-trigger";
        trigger = <&encoder_wake_a_key>;
        wakeup-source;
    };

    encoder_wake_b: encoder_wake_b {
        compatible = "zmk,gpio-key-wakeup-trigger";
        trigger = <&encoder_wake_b_key>;
        wakeup-source;
    };

    soft_off_wakers: soft_off_wakers {
        compatible = "zmk,soft-off-wakeup-sources";
        wakeup-sources =
            <&deep_wake_row0
             &deep_wake_row1
             &deep_wake_row2
             &encoder_wake_a
             &encoder_wake_b>;
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder0>;
        triggers-per-rotation = <20>;
    };

    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &lumi_macropad_layout;
        zephyr,display = &lumi_tft;
        zmk,underglow = &led_strip;
    };
};

&pinctrl {
    lumi_tft_spi_default: lumi_tft_spi_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>;
        };
    };

    lumi_tft_spi_sleep: lumi_tft_spi_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 20)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 17)>;
            low-power-enable;
        };
    };

    /* WS2812 transport uses the dedicated nRF I2S peripheral instead of
     * consuming another SPIM instance. Only SDOUT (P0.06 / D1) is wired to
     * the LED chain; SCK/LRCK are routed to otherwise-unused GPIOs.
     */
    lumi_rgb_i2s_default: lumi_rgb_i2s_default {
        group1 {
            psels = <NRF_PSEL(I2S_SCK_M, 0, 4)>,
                    <NRF_PSEL(I2S_LRCK_M, 0, 5)>,
                    <NRF_PSEL(I2S_SDOUT, 0, 6)>;
        };
    };

    lumi_rgb_i2s_sleep: lumi_rgb_i2s_sleep {
        group1 {
            psels = <NRF_PSEL(I2S_SCK_M, 0, 4)>,
                    <NRF_PSEL(I2S_LRCK_M, 0, 5)>,
                    <NRF_PSEL(I2S_SDOUT, 0, 6)>;
            low-power-enable;
        };
    };

    /* Dedicated external W25Q128 bus.
     * Completely separate from the ST7789 and WS2812 peripherals:
     *   SCK  P1.07
     *   MOSI P1.02
     *   MISO P1.01
     *   CS   P0.11
     */
    lumi_flash_spi_default: lumi_flash_spi_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 7)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 2)>,
                    <NRF_PSEL(SPIM_MISO, 1, 1)>;
        };
    };

    lumi_flash_spi_sleep: lumi_flash_spi_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 7)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 2)>,
                    <NRF_PSEL(SPIM_MISO, 1, 1)>;
            low-power-enable;
        };
    };
};

// ST7789 1.47 inch, physical panel 172x320, used in landscape as 320x172.
// Original Arduino wiring:
// MOSI P0.17, SCLK P0.20, CS P0.22, DC P0.24, RST P1.00.
// ZMK v0.3 uses Zephyr 3.5, whose ST7789 driver expects the display node
// directly below the SPI controller.
// Only SPIM3 on nRF52840 supports 32 MHz. SPIM1 silently clamps the
// requested 32 MHz to 8 MHz in Zephyr, stretching each RGB565 frame to
// at least 110 ms. Pin routing is independent of the peripheral instance.
&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&lumi_tft_spi_default>;
    pinctrl-1 = <&lumi_tft_spi_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;

    lumi_tft: st7789v@0 {
        compatible = "sitronix,st7789v";
        spi-max-frequency = <32000000>;
        reg = <0>;
        cmd-data-gpios = <&gpio0 24 GPIO_ACTIVE_LOW>;
        reset-gpios = <&gpio1 0 GPIO_ACTIVE_LOW>;
        width = <320>;
        height = <172>;
        x-offset = <0>;
        y-offset = <34>;
        vcom = <0x19>;
        gctrl = <0x35>;
        vrhs = <0x12>;
        vdvs = <0x20>;
        // Landscape orientation rotated 180 degrees from the previous build:
        // MY + MV. Keep BGR cleared so red/blue stay in the correct RGB order.
        mdac = <0xA0>;
        gamma = <0x01>;
        colmod = <0x05>;
        lcm = <0x2c>;
        porch-param = [0c 0c 00 33 33];
        cmd2en-param = [5a 69 02 01];
        pwctrl1-param = [a4 a1];
        pvgam-param = [D0 04 0D 11 13 2B 3F 54 4C 18 0D 0B 1F 23];
        nvgam-param = [D0 04 0C 11 13 2C 3F 44 51 2F 1F 1F 20 23];
        ram-param = [00 F0];
        rgb-param = [CD 08 14];
    };
};

/* External W25Q128JV (16 MiB / 128 Mbit) on a dedicated SPIM2 bus.
 *
 * Layout:
 *   0x000000..0x9FFFFF  10 MiB GIF/screensaver media
 *   0xA00000..0xBFFFFF   2 MiB icon/UI/animation assets
 *   0xC00000..0xFFFFFF   4 MiB reserve/cache/update staging
 *
 * Firmware still executes from the nRF52840 internal flash; this external
 * NOR is storage only.
 */
&spi2 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&lumi_flash_spi_default>;
    pinctrl-1 = <&lumi_flash_spi_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;

    lumi_ext_flash: w25q128@0 {
        compatible = "jedec,spi-nor";
        reg = <0>;
        spi-max-frequency = <8000000>;
        /* 128 Mbit / 16 MiB. SFDP is read at runtime so compatible
         * W25Q128/GD25Q128-class parts can be used on this module.
         */
        size = <134217728>;
        has-dpd;
        t-enter-dpd = <3000>;
        t-exit-dpd = <30000>;
        status = "okay";

        partitions {
            compatible = "fixed-partitions";
            #address-cells = <1>;
            #size-cells = <1>;

            lumi_saver_partition: partition@0 {
                label = "lumi-gif";
                reg = <0x000000 0xA00000>;
            };

            lumi_assets_partition: partition@a00000 {
                label = "lumi-assets";
                reg = <0xA00000 0x200000>;
            };

            lumi_reserve_partition: partition@c00000 {
                label = "lumi-reserve";
                reg = <0xC00000 0x400000>;
            };
        };
    };
};

// Six WS2812B LEDs on P0.06 / D1.
// Use nRF52840 I2S to generate the 800 kHz waveform. This keeps RGB fully
// independent of TFT SPIM3 and external-flash SPIM2, and avoids the SPIM1/0
// regression that left the physical strip latched white.
&i2s0 {
    status = "okay";
    pinctrl-0 = <&lumi_rgb_i2s_default>;
    pinctrl-1 = <&lumi_rgb_i2s_sleep>;
    pinctrl-names = "default", "sleep";
};

/ {
    led_strip: ws2812 {
        compatible = "worldsemi,ws2812-i2s";
        status = "okay";
        i2s-dev = <&i2s0>;
        chain-length = <6>;
        reset-delay = <50>;
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};

&lumi_macropad_layout {
    kscan = <&kscan0>;
    transform = <&default_transform>;
};


/* Dedicated USB serial port for LumiPad PC app.
 * ZMK Studio keeps using its own CDC ACM interface.
 */
&zephyr_udc0 {
    lumi_app_uart: lumi_app_uart {
        compatible = "zephyr,cdc-acm-uart";
    };
};


/* External W25Q128 now owns all media storage. Restore the full original
 * nice!nano application partition (0x26000..0xEC000) to firmware. The
 * nRF52840's internal 1 MiB remains dedicated to SoftDevice/firmware/NVS/
 * bootloader according to the board partition map.
 */
&code_partition {
    reg = <0x26000 0xC6000>;
};


/* ST7789 backlight control (BLK) on P0.08.
 * P0.08 is unused by the matrix, encoder, TFT SPI/control and WS2812 buses.
 * Keep BLK LOW during Zephyr startup so the panel stays dark until LVGL has
 * drawn the boot splash.
 */
&gpio0 {
    lumi_panel_backlight_hog {
        gpio-hog;
        gpios = <8 GPIO_ACTIVE_HIGH>;
        output-low;
        line-name = "lumi-tft-backlight";
    };
};
